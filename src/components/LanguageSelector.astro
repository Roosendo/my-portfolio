---
import SpainFlag from '../assets/icons/flags/SPAIN.astro'
import UsaFlag from '../assets/icons/flags/USA.astro'
import ChevronIcon from '../assets/icons/Chevron.astro'

const { currentLocale = 'en', url } = Astro

const pathname = url.pathname

let restUrl: string

if (pathname.startsWith('/es')) {
  const segments = pathname.split('/').slice(2)
  restUrl = '/' + segments.join('/').replace(/\/+$/, '')
} else {
  restUrl = pathname.replace(/\/+$/, '')
}

const LOCALES: Record<string, { code: string; name: string; href: string; flag: typeof UsaFlag }> =
  {
    es: {
      code: 'es',
      href: `/es${restUrl}`,
      name: 'Español',
      flag: SpainFlag
    },
    en: {
      code: 'en',
      href: restUrl,
      name: 'English',
      flag: UsaFlag
    }
  }

const currentLocaleData = LOCALES[currentLocale]
const otherLocales = Object.values(LOCALES).filter((locale) => locale.code !== currentLocale)
const currentPath = url.pathname.replace(currentLocaleData!.href, '')
---

<div class='relative'>
  <div class='group'>
    <button
      type='button'
      class='inline-flex items-center gap-1 text-ink-2 hover:text-accent transition-colors text-sm'
      aria-expanded='true'
      aria-haspopup='true'
    >
      {currentLocaleData?.flag && <currentLocaleData.flag class='size-4' />}
      <ChevronIcon class='size-3 duration-200 group-hover:rotate-180' />
    </button>
    <ul
      class='absolute right-0 top-full mt-1 hidden w-max rounded-lg border border-rule bg-surface p-1 shadow-sm group-hover:block'
    >
      {
        otherLocales.map((locale) => (
          <li>
            <a
              class='inline-flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-ink hover:bg-paper-2 transition-colors'
              href={`${locale.href}${currentPath}`}
            >
              <locale.flag class='size-4' />
              {locale.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
