---
import { getI18N } from '@c/i18n'
import ChevronIcon from '../assets/icons/Chevron.astro'
import SpainFlag from '../assets/icons/flags/SPAIN.astro'
import UsaFlag from '../assets/icons/flags/USA.astro'

const { currentLocale = 'en', url } = Astro
const i18n = getI18N({ currentLocale })

const pathname = url.pathname

let restUrl: string

if (pathname.startsWith('/es')) {
  const segments = pathname.split('/').slice(2)
  restUrl = `/${segments.join('/').replace(/\/+$/, '')}`
} else {
  restUrl = pathname.replace(/\/+$/, '')
}

const LOCALES: Record<string, { code: string; name: string; href: string; flag: typeof UsaFlag }> =
  {
    es: {
      code: 'es',
      href: `/es${restUrl}`,
      name: 'Español',
      flag: SpainFlag
    },
    en: {
      code: 'en',
      href: restUrl,
      name: 'English',
      flag: UsaFlag
    }
  }

const currentLocaleData = LOCALES[currentLocale]
const otherLocales = Object.values(LOCALES).filter((locale) => locale.code !== currentLocale)
const currentPath = url.pathname.replace(currentLocaleData!.href, '')
---

<div class='relative'>
  <div class='group'>
    <button
      type='button'
      class='text-ink-2 hover:text-accent inline-flex items-center gap-1 p-1 text-sm transition-colors'
      aria-label={i18n.HEADER.LANGUAGE}
    >
      {currentLocaleData?.flag && <currentLocaleData.flag class='size-4' />}
      <ChevronIcon
        class='size-3 duration-200 group-focus-within:rotate-180 group-hover:rotate-180'
      />
    </button>
    <ul
      class='border-rule bg-surface absolute top-full right-0 mt-1 hidden w-max rounded-lg border p-1 shadow-sm group-focus-within:block group-hover:block'
    >
      {
        otherLocales.map((locale) => (
          <li>
            <a
              class='text-ink hover:bg-paper-2 inline-flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors'
              href={`${locale.href}${currentPath}`}
            >
              <locale.flag class='size-4' />
              {locale.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
