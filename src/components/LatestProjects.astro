---
import Code from '@icons/Code.astro'
import PivotCard from './PivotCard.astro'
import { getProjects } from '@u/PROJECTS.ts'

import { getI18N } from '@c/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const PROJECTS = getProjects(currentLocale || '')
---

<div class='flex flex-col gap-6'>
  <div class='text-ink-2 flex items-center gap-2'>
    <Code class='size-4' />
    <h2 class='font-display text-ink text-lg font-semibold tracking-tight'>
      {i18n.PROJECTS.LABEL}
    </h2>
  </div>
  <div class='flex flex-col gap-6'>
    {
      PROJECTS.map((project) => (
        <PivotCard
          title={project.title}
          body={project.body}
          imgs={project.imgs}
          projectLink={project.projectLink}
          githubUrl={project.githubUrl}
          languages={project.languages}
        />
      ))
    }
  </div>
</div>
