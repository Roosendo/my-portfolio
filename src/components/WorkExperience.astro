---
import Briefcase from '@icons/Briefcase.astro'

import { getI18N } from '@c/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='flex flex-col gap-6'>
  <div class='flex items-center gap-2 text-ink-2'>
    <Briefcase class='size-4' />
    <h2 class='font-display text-lg font-semibold tracking-tight text-ink'>{i18n.WORK_EXPERIENCE.LABEL}</h2>
  </div>
  <div class='relative border-l-2 border-accent/30 pl-6 space-y-8'>
    {
      i18n.WORK_EXPERIENCE.JOBS.map((job) => (
        <div class='relative'>
          <div class='absolute -left-[calc(1.5rem+5px)] top-1.5 size-2.5 rounded-full bg-accent ring-2 ring-paper' />
          <time class='block text-xs font-medium text-ink-3 uppercase tracking-wider'>{job.TIME}</time>
          <h3 class='mt-1 font-display text-lg font-bold tracking-tight text-ink'>{job.TITLE}</h3>
          <p class='mt-1 text-base leading-relaxed text-ink-2'>{job.DESCRIPTION}</p>
        </div>
      ))
    }
  </div>
</div>
