---
import { getI18N } from '@c/i18n'
import Briefcase from '@icons/Briefcase.astro'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='flex flex-col gap-6'>
  <div class='text-ink-2 flex items-center gap-2'>
    <Briefcase class='size-4' />
    <h2 class='font-display text-ink text-lg font-semibold tracking-tight'>
      {i18n.WORK_EXPERIENCE.LABEL}
    </h2>
  </div>
  <div class='border-accent/30 relative space-y-8 border-l-2 pl-6'>
    {
      i18n.WORK_EXPERIENCE.JOBS.map((job) => (
        <div class='relative'>
          <div class='bg-accent ring-paper absolute top-1.5 -left-7.25 size-2.5 rounded-full ring-2' />
          <time class='text-ink-3 block text-xs font-medium tracking-wider uppercase'>
            {job.TIME}
          </time>
          <h3 class='font-display text-ink mt-1 text-lg font-bold tracking-tight'>{job.TITLE}</h3>
          <p class='text-ink-2 mt-1 text-base leading-relaxed'>{job.DESCRIPTION}</p>
        </div>
      ))
    }
  </div>
</div>
