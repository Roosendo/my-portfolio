---
import Trophy from '@icons/Trophy.astro'
import { SKILLS } from '../utils/SKILLS.ts'

import { getI18N } from '@c/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='flex flex-col gap-4'>
  <div class='text-ink-2 flex items-center gap-2'>
    <Trophy class='size-4' />
    <h2 class='font-display text-ink text-lg font-semibold tracking-tight'>{i18n.SKILLS.LABEL}</h2>
  </div>
  <div class='flex flex-wrap gap-2'>
    {
      SKILLS.map((skill) => (
        <div
          class={`inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition-all ${
            skill.featured
              ? 'border-accent text-accent bg-accent/5'
              : 'border-rule text-ink-2 hover:border-accent hover:text-accent hover:bg-paper-2'
          } `}
        >
          <skill.icon class='size-4' />
          <span>{skill.name}</span>
        </div>
      ))
    }
  </div>
</div>
