---
import { getI18N } from '@c/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<footer class='border-rule mt-16 border-t'>
  <div class='mx-auto max-w-3xl px-4 py-8 text-center'>
    <p class='text-ink-3 text-sm'>
      {i18n.FOOTER.LABEL_3} · <a
        href='https://github.com/Roosendo'
        target='_blank'
        rel='noopener noreferrer'
        class='text-accent hover:underline'>GitHub</a
      >
      · <a
        href='https://www.linkedin.com/in/rosendoo-garcia'
        target='_blank'
        rel='noopener noreferrer'
        class='text-accent hover:underline'>LinkedIn</a
      >
      · <a
        href='https://x.com/callmerosendo'
        target='_blank'
        rel='noopener noreferrer'
        class='text-accent hover:underline'>Twitter</a
      >
    </p>
    <p class='text-ink-3 mt-2 text-xs'>&copy; {new Date().getFullYear()} Rosendo Garcia</p>
  </div>
</footer>
