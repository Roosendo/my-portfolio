---
const WrapperTag = Astro.props.href ? 'a' : 'p'
---

<WrapperTag
  class={`
    inline-flex items-center gap-2 rounded-full border border-rule
    px-3 py-1.5 text-sm text-ink-2
    transition-all
    hover:border-accent hover:text-accent hover:bg-paper-2
    ${Astro.props.class ?? ''}
  `}
  href={Astro.props.href}
  target='_blank'
  rel='noopener noreferrer'
>
  <slot />
</WrapperTag>
