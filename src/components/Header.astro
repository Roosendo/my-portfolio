---
import { getI18N } from '@c/i18n'
import { Toggle } from 'astro-theme-toggle'
import LanguageSelector from './LanguageSelector.astro'

const rawPath = Astro.url.pathname === '/es' ? '/es/' : Astro.url.pathname
const currentLocale = rawPath === '/es/' ? 'es' : 'en'
const homeHref = currentLocale === 'es' ? '/es/' : '/'
const certsHref = currentLocale === 'es' ? '/es/certificates' : '/certificates'
const isCertsPage = rawPath === certsHref
const i18n = getI18N({ currentLocale })
---

<header class='border-rule bg-paper/80 sticky top-0 z-50 border-b backdrop-blur-sm'>
  <nav class='mx-auto flex max-w-3xl items-center gap-3 px-4 py-3 sm:gap-4' aria-label='Primary'>
    <a
      href={homeHref}
      class='font-display text-ink hover:text-accent text-base font-bold tracking-tight transition-colors sm:text-lg'
    >
      Rosendo Garcia
    </a>
    <div class="ml-auto flex items-center gap-2 text-xs sm:gap-3 sm:text-sm">
    {
      !isCertsPage && (
        <>
          <a
            href="#projects"
            class="text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors sm:inline-block"
          >
            {i18n.HEADER.PROJECTS}
          </a>

          <a
            href="#about-me"
            class="text-ink-2 hover:text-accent hidden py-1.5 whitespace-nowrap transition-colors sm:inline-block"
          >
            {i18n.HEADER.ABOUT_ME}
          </a>

          <a
            href="#contact"
            class="text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors sm:inline-block"
          >
            {i18n.HEADER.CONTACT}
          </a>

          <a
            href={certsHref}
            class="text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors"
          >
            {i18n.CERTIFICATES.BUTTONS.MAIN_LINK}
          </a>
        </>
      )
    }

    {
      isCertsPage && (
        <a
          href={homeHref}
          class="text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors"
        >
          ← {i18n.CERTIFICATES.BUTTONS.BACK}
        </a>
      )
    }

    <Toggle
      class="text-ink-2 hover:text-accent size-5 transition-colors sm:size-6"
      aria-label={i18n.HEADER.THEME}
    />

    <LanguageSelector />
  </div>
  </nav>
</header>

<style>
  .theme-toggle {
    width: 1rem;
    height: 1rem;
  }
</style>
