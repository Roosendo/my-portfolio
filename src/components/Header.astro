---
import { getI18N } from '@c/i18n'
import { Toggle } from 'astro-theme-toggle'
import LanguageSelector from './LanguageSelector.astro'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<header class='border-rule bg-paper/80 sticky top-0 z-50 border-b backdrop-blur-sm'>
  <nav class='mx-auto flex max-w-3xl items-center gap-4 px-4 py-3' aria-label='Primary'>
    <a
      href='/'
      class='font-display text-ink hover:text-accent text-lg font-bold tracking-tight transition-colors'
    >
      Rosendo Garcia
    </a>
    <div class='ml-auto flex items-center gap-2 text-sm'>
      <a
        href='#projects'
        class='text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors'
        >{i18n.HEADER.PROJECTS}</a
      >
      <a
        href='#about-me'
        class='text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors'
        >{i18n.HEADER.ABOUT_ME}</a
      >
      <a
        href='#contact'
        class='text-ink-2 hover:text-accent py-1.5 whitespace-nowrap transition-colors'
        >{i18n.HEADER.CONTACT}</a
      >
      <Toggle
        class='text-ink-2 hover:text-accent size-6 transition-colors'
        aria-label={i18n.HEADER.THEME}
      />
      <LanguageSelector />
    </div>
  </nav>
</header>

<style>
  .theme-toggle {
    width: 1rem;
    height: 1rem;
  }
</style>
