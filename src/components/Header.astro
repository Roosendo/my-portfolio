---
import { Toggle } from 'astro-theme-toggle'
import LanguageSelector from './LanguageSelector.astro'

import { getI18N } from '@c/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<header class='sticky top-0 z-50 border-b border-rule bg-paper/80 backdrop-blur-sm'>
  <nav class='mx-auto flex max-w-3xl items-center gap-4 px-4 py-3' aria-label='Primary'>
    <a href='/' class='font-display text-lg font-bold tracking-tight text-ink hover:text-accent transition-colors'>
      Rosendo Garcia
    </a>
    <div class='ml-auto flex items-center gap-2 text-sm'>
      <a href='#projects' class='whitespace-nowrap text-ink-2 hover:text-accent transition-colors'>{i18n.HEADER.PROJECTS}</a>
      <a href='#about-me' class='whitespace-nowrap text-ink-2 hover:text-accent transition-colors'>{i18n.HEADER.ABOUT_ME}</a>
      <a href='#contact' class='whitespace-nowrap text-ink-2 hover:text-accent transition-colors'>{i18n.HEADER.CONTACT}</a>
      <Toggle class='size-4 text-ink-2 hover:text-accent transition-colors' />
      <LanguageSelector />
    </div>
  </nav>
</header>

<style>
  .theme-toggle {
    width: 1rem;
    height: 1rem;
  }
</style>
