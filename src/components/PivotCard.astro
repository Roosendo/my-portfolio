---
import { getI18N } from '@c/i18n'
import { SKILLS } from '@u/SKILLS'
import Carousel from './Carousel'
import GitHub from '@icons/GitHub.astro'
import Fire from '@icons/Fire.astro'
import Pill from './Pill.astro'

interface Props {
  title: string
  body: string
  imgs: string[]
  projectLink: string
  githubUrl: string
  languages: string[]
}

const { title, body, imgs, projectLink, githubUrl, languages } = Astro.props

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<article class='surface-card overflow-hidden'>
  <div class='p-5 md:p-6'>
    <h3 class='font-display text-ink text-xl font-bold tracking-tight md:text-2xl'>
      {title}
    </h3>
    <p class='text-ink-2 mt-2 text-base leading-relaxed md:text-lg'>{body}</p>
    <div class='mt-4 flex flex-wrap gap-2'>
      {
        languages.map((lang) => {
          const skill = SKILLS.find((skill) => skill.name === lang)

          return (
            <Pill class='cursor-default text-xs'>
              {skill && <skill.icon class='size-3.5' />}
              <span>{lang}</span>
            </Pill>
          )
        })
      }
    </div>
    {
      imgs && imgs.length > 0 && (
        <div class='mt-4'>
          <Carousel
            slides={imgs}
            alts={imgs.map((_img, i) => `${title} - screenshot ${i + 1}`)}
            autoSlide={imgs.length > 1}
            client:visible
          />
        </div>
      )
    }
    <div class='mt-4 flex gap-3'>
      {
        projectLink && (
          <Pill href={projectLink}>
            <Fire class='size-4' />
            <span>{i18n.PROJECTS.BUTTONS.LIVE}</span>
          </Pill>
        )
      }
      <Pill href={githubUrl}>
        <GitHub class='size-4' />
        <span>{i18n.PROJECTS.BUTTONS.GITHUB}</span>
      </Pill>
    </div>
  </div>
</article>
