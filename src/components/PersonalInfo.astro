---
import Yo from '@imgs/yo.webp'
import Pill from './Pill.astro'
import GitHub from '@icons/GitHub.astro'
import LinkedIn from '@icons/LinkedIn.astro'
import Send from '@icons/Send.astro'
import Copy from '@icons/Copy.astro'
import CVIcon from '@icons/CV.astro'
import AlertMessage from './AlertMessage.astro'
import At from '@icons/At.astro'

import { getI18N } from '@c/i18n'
import { unescapeHTML } from 'astro/compiler-runtime'
import { Image } from 'astro:assets'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

let paragraph = i18n.PERSONAL_INFO.PARAGRAPH
let phrases = i18n.PERSONAL_INFO.PHRASES

for (let phrase in phrases) {
  let replacement = `<span class="${phrases[phrase as keyof typeof phrases]}">${phrase}</span>`
  paragraph = paragraph.split(phrase).join(replacement)
}

const htmlParagraph = unescapeHTML(paragraph)

const CVfinal =
  currentLocale === 'en' ? '/Rosendo-Garcia-Resume-EN.pdf' : '/Rosendo-Garcia-Resume-ES.pdf'
---

<div class='flex flex-col gap-6'>
  <div class='flex flex-col gap-4 md:flex-row md:items-start md:justify-between'>
    <div class='flex flex-col gap-3'>
      <h1 class='font-display text-ink text-3xl font-bold tracking-tight md:text-4xl'>
        {i18n.PERSONAL_INFO.GREETING}
      </h1>
      <a
        href='https://www.linkedin.com/in/rosendoo-garcia'
        target='_blank'
        rel='noopener noreferrer'
        aria-label={i18n.PERSONAL_INFO.PILL_MESSAGE}
        class='border-accent text-accent hover:bg-accent hover:text-paper inline-flex w-fit items-center gap-2 rounded-full border px-3 py-1 text-sm font-medium transition-all'
      >
        <LinkedIn class='size-4' />
        {i18n.PERSONAL_INFO.PILL_MESSAGE}
      </a>
      <div
        class='text-ink-2 max-w-prose text-base leading-relaxed md:text-lg'
        set:html={htmlParagraph}
      />
    </div>
    <div class='shrink-0 md:pt-2'>
      <Image
        src={Yo}
        alt='Rosendo Garcia'
        class='border-paper-2 size-24 rounded-full border-2 object-cover shadow-sm md:size-32'
        loading='eager'
      />
    </div>
  </div>

  <div class='flex flex-wrap items-center gap-3'>
    <Pill href='https://github.com/Roosendo'>
      <GitHub class='text-accent size-4' />
      <span class='text-sm'>GitHub</span>
    </Pill>
    <Pill href='https://www.linkedin.com/in/rosendoo-garcia'>
      <LinkedIn class='text-accent size-4' />
      <span class='text-sm'>LinkedIn</span>
    </Pill>
    <Pill href={CVfinal}>
      <CVIcon class='text-accent size-4' />
      <span class='text-sm'>CV</span>
    </Pill>
  </div>

  <AlertMessage type='success' message={i18n.PERSONAL_INFO.ALERTS.SUCCESS} divId='alert-ok' />
  <AlertMessage type='error' message={i18n.PERSONAL_INFO.ALERTS.ERROR} divId='alert-no' />

  <div class='text-ink-2 flex items-center gap-2 text-sm' transition:persist="main-content">
    <At class='size-4' />
    <span>rosendo.garcia73@outlook.com</span>
    <a
      href='mailto:rosendo.garcia73@outlook.com'
      class='border-rule text-accent hover:bg-paper-2 ml-auto rounded-lg border px-3 py-1.5 text-sm transition-colors'
    >
      <Send class='inline size-4' />
    </a>
    <button
      type='button'
      id='to-copy'
      aria-label='Copy email'
      class='border-rule text-ink-2 hover:bg-paper-2 rounded-lg border px-3 py-1.5 text-sm transition-colors cursor-pointer'
    >
      <Copy class='size-4' />
    </button>
  </div>
</div>

<script>
  import { copyToClipboard, showAndHideAlert } from '@u/CopyFunctionality'

  const container = document.querySelector('#to-copy') as HTMLButtonElement

  if (container) {
    container.addEventListener('click', async () => {
      const email = 'rosendo.garcia73@outlook.com'
      const successfull = await copyToClipboard(email)

      const alertElement = successfull
        ? (document.querySelector('#alert-ok') as HTMLDivElement)
        : (document.querySelector('#alert-no') as HTMLDivElement)

      if (alertElement) {
        showAndHideAlert(alertElement)
      }
    })
  }
</script>
