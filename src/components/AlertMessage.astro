---
interface Props {
  type: 'success' | 'error'
  message: string
  divId: string
}

const { type, message, divId } = Astro.props

const borderColor = type === 'success' ? 'border-accent text-accent' : 'border-red-400 text-red-400'
---

<div
  class=`hidden items-center gap-2 rounded-xl border px-4 py-3 text-sm ${borderColor}`
  id={divId}
  role='alert'
>
  <svg class='size-4 shrink-0' aria-hidden='true' fill='currentColor' viewBox='0 0 20 20'>
    <path
      d='M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z'
    ></path>
  </svg>
  <span>{message}</span>
</div>
