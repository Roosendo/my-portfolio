---
import About from '@c/About.astro'
import Contact from '@c/Contact.astro'
import { getI18N } from '@c/i18n'
import LatestProjects from '@c/LatestProjects.astro'
import PersonalInfo from '@c/PersonalInfo.astro'
import Skills from '@c/Skills.astro'
import WorkExperience from '@c/WorkExperience.astro'
import Layout from '@l/Layout.astro'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<Layout title={i18n.SEO_TITLE} description={i18n.SEO_DESCRIPTION}>
  <div class='flex flex-col gap-16'>
    <section class='reveal' style='--i: 0'><PersonalInfo /></section>
    <section class='reveal' style='--i: 1' id='projects'><LatestProjects /></section>
    <section class='reveal' style='--i: 2'><Skills /></section>
    <section class='reveal' style='--i: 3'><WorkExperience /></section>
    <section class='reveal' style='--i: 4' id='about-me'><About /></section>
    <section class='reveal' style='--i: 5' id='contact'><Contact /></section>
  </div>
</Layout>
